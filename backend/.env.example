# Server Configuration
PORT=5002
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Configuration
# IMPORTANT: Generate a strong random secret key for production
# Example: openssl rand -hex 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret-at-least-64-characters-long-use-crypto-randomBytes
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=50
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
